<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="file:///C:/Program%20Files/rti_connext_dds-7.6.0/bin/../resource/schema/rti_dds_qos_profiles.xsd">
 <qos_library name="Temperature_Library">
  <qos_profile name="Temperature_Profile"
               base_name="BuiltinQosLibExp::Generic.BestEffort"
               is_default_qos="true">

 <domain_participant_qos>
  <participant_name>
    <name>TemperatureParticipant</name>
    <role_name>TemperatureParticipantRole</role_name>
  </participant_name>
 	<transport_builtin>
          <udpv4>
            <allow_interfaces_list>
              <element>172.23.100.102</element>
            </allow_interfaces_list>
            <max_interface_count>1</max_interface_count>
        </udpv4>
        </transport_builtin>
		<discovery>
                    <initial_peers>
                        <element>4@builtin.udpv4://172.23.100.101</element>
                    </initial_peers>
		</discovery>
</domain_participant_qos>

    <datawriter_qos>
      <publication_name>
        <name>TemperatureDataWriter</name>
      </publication_name>
    </datawriter_qos>

    <datareader_qos>
      <subscription_name>
        <name>TemperatureDataReader</name>
      </subscription_name>
    </datareader_qos>

  </qos_profile>
</qos_library>
</dds>
