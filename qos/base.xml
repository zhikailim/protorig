<?xml version="1.0" encoding="UTF-8"?>
<!--
  base.xml — participant defaults shared by every node.

  No IP addresses here: each node's interface restriction and peer list are
  generated by `protorig run` into build/<scenario>/<node>/node_qos.xml, whose
  profile is based on this one (Base).
-->
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="https://community.rti.com/schema/current/rti_dds_qos_profiles.xsd">
  <qos_library name="protorig_base">

    <qos_profile name="Base">
      <domain_participant_qos>
        <discovery_config>
          <!-- A participant that vanishes (cable pulled, process killed) is
               dropped after 10 s instead of the default 100 s. App-level
               "is it alive?" uses the faster NodeStatus liveliness (3 s). -->
          <participant_liveliness_lease_duration>
            <sec>10</sec><nanosec>0</nanosec>
          </participant_liveliness_lease_duration>
          <participant_liveliness_assert_period>
            <sec>2</sec><nanosec>0</nanosec>
          </participant_liveliness_assert_period>
        </discovery_config>
      </domain_participant_qos>
    </qos_profile>

  </qos_library>
</dds>
