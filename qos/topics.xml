<?xml version="1.0" encoding="UTF-8"?>
<!--
  topics.xml — how each topic behaves, assigned by topic name (topic_filter).

  Apps contain no QoS code: they create readers and writers with default QoS,
  and this profile (the default) gives each topic its behaviour. To change
  behaviour, edit this file and restart the app; nothing is rebuilt.

  RULE for topics published by external nodes (external/*/external.yaml):
  readers may request only what the external writer offers, or less. A reader
  asking for more (e.g. RELIABLE, or any finite deadline, against a writer that
  offers BEST_EFFORT and no deadline) silently never matches. `protorig check`
  enforces this for this profile and every variant.
-->
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="https://community.rti.com/schema/current/rti_dds_qos_profiles.xsd">
  <qos_library name="protorig">

    <qos_profile name="Topics" base_name="protorig_base::Base" is_default_qos="true">

      <!-- ============ Example Temperature: TC397 temperature (external) ============ -->
      <!-- The writer entry is used by the sim twin, and mirrors what the real ECU
           offers (external/tc397/external.yaml), so sim runs behave like hardware. -->
      <datawriter_qos topic_filter="Example Temperature">
        <reliability><kind>RELIABLE_RELIABILITY_QOS</kind></reliability>
        <durability><kind>VOLATILE_DURABILITY_QOS</kind></durability>
        <history><kind>KEEP_LAST_HISTORY_QOS</kind><depth>1</depth></history>
        <!-- Same reliability heartbeat as the ECU (Temperature_publisher.c: 250 ms) -->
        <protocol><rtps_reliable_writer>
          <heartbeat_period><sec>0</sec><nanosec>250000000</nanosec></heartbeat_period>
        </rtps_reliable_writer></protocol>
      </datawriter_qos>
      <datareader_qos topic_filter="Example Temperature">
        <reliability><kind>BEST_EFFORT_RELIABILITY_QOS</kind></reliability>
        <durability><kind>VOLATILE_DURABILITY_QOS</kind></durability>
        <!-- Local only (not matched against the writer): keep recent samples for plots. -->
        <history><kind>KEEP_LAST_HISTORY_QOS</kind><depth>50</depth></history>
        <!-- Best effort on purpose: plots want the latest value, not retransmissions.
             No deadline or liveliness here: the ECU offers neither. -->
      </datareader_qos>

      <!-- ============ Alert: must not be lost; late joiners see active alerts ============ -->
      <datawriter_qos topic_filter="Alert">
        <reliability><kind>RELIABLE_RELIABILITY_QOS</kind></reliability>
        <durability><kind>TRANSIENT_LOCAL_DURABILITY_QOS</kind></durability>
        <history><kind>KEEP_LAST_HISTORY_QOS</kind><depth>1</depth></history>
      </datawriter_qos>
      <datareader_qos topic_filter="Alert">
        <reliability><kind>RELIABLE_RELIABILITY_QOS</kind></reliability>
        <durability><kind>TRANSIENT_LOCAL_DURABILITY_QOS</kind></durability>
        <history><kind>KEEP_LAST_HISTORY_QOS</kind><depth>1</depth></history>
      </datareader_qos>

      <!-- ============ _sys/NodeStatus: 1 Hz heartbeat; silence = dead ============ -->
      <datawriter_qos topic_filter="_sys/NodeStatus">
        <reliability><kind>BEST_EFFORT_RELIABILITY_QOS</kind></reliability>
        <history><kind>KEEP_LAST_HISTORY_QOS</kind><depth>1</depth></history>
        <deadline><period><sec>2</sec><nanosec>0</nanosec></period></deadline>
        <liveliness>
          <kind>AUTOMATIC_LIVELINESS_QOS</kind>
          <lease_duration><sec>3</sec><nanosec>0</nanosec></lease_duration>
        </liveliness>
      </datawriter_qos>
      <datareader_qos topic_filter="_sys/NodeStatus">
        <reliability><kind>BEST_EFFORT_RELIABILITY_QOS</kind></reliability>
        <history><kind>KEEP_LAST_HISTORY_QOS</kind><depth>1</depth></history>
        <deadline><period><sec>3</sec><nanosec>0</nanosec></period></deadline>
        <liveliness>
          <kind>AUTOMATIC_LIVELINESS_QOS</kind>
          <lease_duration><sec>3</sec><nanosec>0</nanosec></lease_duration>
        </liveliness>
      </datareader_qos>

      <!-- ============ _sys/DemoControl: a button press must arrive ============ -->
      <datawriter_qos topic_filter="_sys/DemoControl">
        <reliability><kind>RELIABLE_RELIABILITY_QOS</kind></reliability>
        <history><kind>KEEP_LAST_HISTORY_QOS</kind><depth>16</depth></history>
      </datawriter_qos>
      <datareader_qos topic_filter="_sys/DemoControl">
        <reliability><kind>RELIABLE_RELIABILITY_QOS</kind></reliability>
        <history><kind>KEEP_LAST_HISTORY_QOS</kind><depth>16</depth></history>
      </datareader_qos>

    </qos_profile>

  </qos_library>
</dds>
